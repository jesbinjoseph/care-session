# Local workshop values only. Never reuse these values in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_DB=care
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@db:5432/care

REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0

DJANGO_SETTINGS_MODULE=config.settings.deployment
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-workshop-only
DJANGO_ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
CORS_ALLOWED_ORIGINS=["http://localhost:4000"]
CSRF_TRUSTED_ORIGINS=["http://localhost:4000"]
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=false

BUCKET_REGION=ap-south-1
BUCKET_KEY=minioadmin
BUCKET_SECRET=minioadmin
BUCKET_ENDPOINT=http://minio:9000
BUCKET_EXTERNAL_ENDPOINT=http://localhost:9100
BUCKET_HAS_FINE_ACL=false
FILE_UPLOAD_BUCKET=patient-bucket
FACILITY_S3_BUCKET=facility-bucket

DJANGO_ADMIN_URL=admin
SNS_ACCESS_KEY=local-workshop
SNS_SECRET_KEY=local-workshop
EMAIL_HOST=localhost
EMAIL_USER=local-workshop
EMAIL_PASSWORD=local-workshop

# Backend plugs are installed into the shared CARE image at build time.
# Keep [] for core CARE. Pin every plug version when adding entries.
ADDITIONAL_PLUGS=[]
